PORT=5000
NODE_ENV=development

# At least 32 random characters. Do not use a short or shared default.
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret

MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dhara

EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Public site URL. Google sign-in returns the user here.
FRONTEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

OPENWEATHER_API_KEY=your-openweather-key
DATA_GOV_KEY=your-data-gov-in-key

# Set to none on a host that has no Arduino attached.
ARDUINO_PORT=COM11
SENSOR_DEMO=false
